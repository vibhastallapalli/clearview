# Copy to .env in the repo root. Never commit the real .env.

# Gemini. Leave empty to run with clearly labelled MOCK analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server
PORT=3001
# Public URL the phone uses to open the capture page (must be HTTPS for phone cameras).
# Local dev: run `ngrok http 5173` and paste the https URL here.
PUBLIC_WEB_URL=http://localhost:5173

# Shared secret the receiving station sends with every capture.
STATION_TOKEN=change-me

# Solana (devnet only, no real funds). Setup: npm run setup:devnet (see solana/README.md)
# A private RPC URL may contain an API key: don't share it.
SOLANA_RPC_URL=https://api.devnet.solana.com
# CDT (ClearDock test dollars) mint: classic SPL token, 2 decimals. Never call it USDC.
# The only mint setting. The browser reads it from GET /api/config; no VITE_ copy is needed.
DEMO_TOKEN_MINT=
# Public Phantom (devnet) addresses. Public keys only, never seed phrases.
DEMO_BUYER_WALLET=
# Seeds the demo supplier's verified wallet (overrides shared/fixtures/supplier.json).
# After changing it, reset demo data: POST /api/dev/reset.
DEMO_SUPPLIER_WALLET=
# Optional: mint-authority keypair for setup only (default solana/.keys/cdt-mint-authority.json).
# Secret. The server never reads it. Keep it outside the repo or under solana/.keys/.
DEMO_MINT_AUTHORITY_PATH=

# ClearDock escrow program on devnet (public). Returned by GET /api/config; enables POST /orders/:id/escrow/events.
ESCROW_PROGRAM_ID=Bk4DD3mGCJRFATHTnLqyoxiWDm65nfMcPfE7oduiQzAt
