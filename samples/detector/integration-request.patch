diff --git a/server/src/ai/detector-integration.test.ts b/server/src/ai/detector-integration.test.ts
new file mode 100644
index 0000000..315ce0b
--- /dev/null
+++ b/server/src/ai/detector-integration.test.ts
@@ -0,0 +1,57 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { readFileSync } from "node:fs";
+import { createHash } from "node:crypto";
+import { compareOrder, type ExtractedDocument, type ScanResult } from "@cleardock/shared";
+import { adaptDetectorCsv } from "./detector-csv.ts";
+
+const catalog = JSON.parse(readFileSync(new URL("../../../samples/detector/redbull.products.json", import.meta.url), "utf8"));
+const config = JSON.parse(readFileSync(new URL("../../../samples/detector/csv-config.proposed.json", import.meta.url), "utf8"));
+const image = Buffer.from("synthetic");
+const hash = (x: Buffer) => createHash("sha256").update(x).digest("hex");
+const po: ExtractedDocument = { id: "po", orderId: "order", kind: "purchase_order", source: { filename: "synthetic", mimeType: "image/png", sha256: "" },
+  extractedAt: "", extractedBy: "mock", supplierName: null, orderReference: "order", currency: "USD", language: "en", totalMinor: 750,
+  warnings: [], lines: [{ sku: "RB-ORIGINAL-250ML", description: "Original", quantity: 3, unit: "unit", unitPriceMinor: 250, confidence: 1, sourceText: "synthetic" }] };
+function comparison(rows: string[], emptyTray = false) {
+  const csv = Buffer.from("item_id,class,confidence,damage\n" + rows.map((r, i) => `${i},${r}`).join("\n"));
+  const result = adaptDetectorCsv(csv, { format: "cleardock.csv.v1", orderId: "order", imageSha256: hash(image), csvSha256: hash(csv), model: config.model,
+    rowCount: rows.length, frames: 1, complete: true, emptyTray, synthetic: true }, { orderId: "order", image }, config, catalog);
+  const scan: ScanResult = { ...result, id: "s", captureId: "c", orderId: "order", analyzedAt: "", analyzedBy: "detector" };
+  return compareOrder({ orderId: "order", evidenceRevision: 1, purchaseOrder: po, invoice: { ...po, kind: "invoice" }, scan });
+}
+const good = "redbull_original_250ml,0.93,ok";
+const damage = "redbull_original_250ml,0.93,damaged";
+test("missing and damaged are separate, and mixed shortage never double-counts", () => {
+  const missing = comparison([good, good]);
+  assert.equal(missing.lines[0].missing, 1);
+  assert.equal(missing.lines[0].damaged, 0);
+  const damaged = comparison([good, good, damage]);
+  assert.equal(damaged.lines[0].verdict, "damaged");
+  assert.equal(damaged.lines[0].observed, 3);
+  assert.equal(damaged.lines[0].missing, 0);
+  assert.equal(damaged.lines[0].damagedMinor, 250);
+  assert.equal(damaged.undisputedMinor, 500);
+  const both = comparison([good, damage]);
+  assert.equal(both.lines[0].missingMinor, 250);
+  assert.equal(both.lines[0].damagedMinor, 250);
+  assert.equal(both.lines[0].discrepancyMinor, 500);
+  assert.equal(both.undisputedMinor, 250);
+});
+test("variant substitution, uncertainty and empty trays", () => {
+  const wrong = comparison([good, good, "redbull_sugarfree_250ml,0.9,ok"]);
+  assert.deepEqual(wrong.lines.map((l) => l.verdict), ["missing", "unexpected"]);
+  for (const row of ["redbull_original_250ml,0.2,ok", "unknown,0.9,ok", "redbull_original_250ml,0.9,unknown"]) {
+    const r = comparison([good, row]);
+    assert.equal(r.outcome, "needs_info");
+    assert.equal(r.lines[0].observed, null);
+    assert.equal(r.undisputedMinor, 0);
+  }
+  assert.equal(comparison([]).outcome, "needs_info");
+  assert.equal(comparison([], true).lines[0].missing, 3);
+  assert.equal(comparison([], true).outcome, "discrepancy");
+});
+test("extra damaged cans cannot increase the claim above ordered units", () => {
+  const r = comparison([good, good, good, damage]);
+  assert.equal(r.lines[0].damagedMinor, 0);
+  assert.equal(r.undisputedMinor, 750);
+});
