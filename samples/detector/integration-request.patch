@@ -0,0 +1,29 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { remedyDefault, type OrderDetail } from "@cleardock/shared";
+import { scanLines } from "../escrow/demo";
+import { claimWrite } from "./claim";
+import type { AgreementState } from "./contract";
+test("damage reaches the signed claim reason and remains distinct from shortage", () => {
+  const detail = { order: { latestScanId: "s", comparison: { outcome: "discrepancy", lines: [
+    { sku: "RB", description: "Red Bull", ordered: 3, billed: 3, observed: 2, damaged: 1, unitPriceMinor: 250 },
+  ] } }, proofs: [] } as unknown as OrderDetail;
+  const lines = scanLines(detail)!;
+  const write = claimWrite({ revision: 0 } as AgreementState, detail, lines, { scanId: "s", revision: 1 });
+  assert.equal(write.action, "prepare_claim");
+  if (write.action !== "prepare_claim") throw new Error("wrong action");
+  assert.deepEqual(write.lines.map((l) => [l.reason, l.claimedMinor]), [["damaged", 250], ["missing", 250]]);
+  assert.equal(write.claimedMinor, 500);
+  assert.deepEqual(write.decisions.map((x) => x.suggested), ["accept", "claim", "claim"]);
+});
+
+test("a damaged line takes the signed damaged remedy, not the missing one", () => {
+  const detail = { order: { latestScanId: "s", comparison: { outcome: "discrepancy", lines: [
+    { sku: "RB", description: "Red Bull", ordered: 3, billed: 3, observed: 2, damaged: 1, unitPriceMinor: 250 },
+  ] } }, proofs: [] } as unknown as OrderDetail;
+  const write = claimWrite({ revision: 0, remedy: null } as AgreementState, detail, scanLines(detail)!, { scanId: "s", revision: 1 });
+  if (write.action !== "prepare_claim") throw new Error("wrong action");
+  const split = remedyDefault(write.lines, 750, { missing: 100, damaged: 50, wrong_item: 100 }, 1)!;
+  assert.deepEqual(split.basis.map((b) => [b.reason, b.refundPercent, b.refundMinor]), [["damaged", 50, 125], ["missing", 100, 250]]);
+  assert.deepEqual([split.toBuyerMinor, split.toSupplierMinor], [375, 375]);
+});
